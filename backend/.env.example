# ServiGo backend — copy to ".env" on the server and fill in real values.
# Only the variables the code actually reads are listed here.

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000

# Browser origins allowed to call the API and open a Socket.IO connection.
# localhost:5173 is always allowed in addition to this. Comma-separate for
# more than one. No trailing slash.
CLIENT_URL=https://your-domain.com

# ── Database ──────────────────────────────────────────────────────────────
# Use the "mongodb+srv://" form from Atlas → Connect on the server.
# (A non-SRV "mongodb://host1,host2,host3/..." form is only needed on
# machines whose DNS can't resolve SRV records.)
# Remember: add the server's IP under Atlas → Network Access, or the
# connection times out with a misleading "IP isn't whitelisted" message.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/service_marketplace?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate fresh secrets for production — do NOT reuse the development ones:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (image & file uploads) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (OTP, password reset) ───────────────────────────────────────────
# For Gmail this must be an App Password, not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=ServiGo <no-reply@your-domain.com>

# ── Marketplace ───────────────────────────────────────────────────────────
# Platform commission as a fraction. 0.1 = 10%. Snapshotted onto each
# invoice at approval time, so changing it never rewrites invoices already
# in flight.
COMMISSION_RATE=0.1
